# Copy this file to .env.local for `npm run dev`. Every line below is commented out: uncomment a line to set it.
# Anything in a VITE_* variable is public: Vite inlines it into the built bundle, so every visitor can read it.

# Backend base URL. The dev default is http://localhost:8000; a build defaults to the same origin.
# VITE_API_BASE=http://localhost:8000

# Bearer token for a backend that sets REBUTTAL_API_TOKEN (replace <token> with that backend's token).
# For `npm run dev` ONLY: `npm run build` refuses to run while this is set.
# VITE_API_TOKEN=
