    "id": "agent_wrong_size",
    "title": "Buyer's AI assistant ordered the wrong size",
    "reason": "MERCHANDISE_OR_SERVICE_NOT_AS_DESCRIBED",
    "stage": "INQUIRY",
    "days_since_purchase": 8,
    "days_open": 1,
    "buyer_message": "I asked for a medium. This is a large. Not what I ordered.",
    "item": {
      "sku": "LIN-SHIRT",
      "name": "Linen shirt",
      "variant": "Navy / Size L",
      "price": 48.0
    },
    "ship_to": "418 Maple Ave, Austin, TX 78704",
    "shipment": {
      "carrier": "USPS",
      "number": "9400111899223344556677",
      "status": "DELIVERED",
      "delivered_to": "418 Maple Ave, Austin, TX 78704",
      "days_after_purchase": 3
    },
    "agent_purchase": {
      "agent": "Atlas (buyer's AI shopping assistant)",
      "instruction": "Get my brother the navy linen shirt in medium, under $60.",
      "constraints": {
        "variant": "Size M",
        "max_price": 60
      }
    },
    "expected": "OFFER_RETURN_FOR_REFUND",
    "hard": false,
    "why": "We shipped exactly what was ordered (L). The buyer's assistant was told medium and picked large. PayPal allows only REFUND / REFUND_WITH_RETURN offers on this dispute, so the offer is a full refund once the return is scanned, with the medium shipped then. Store policy covers assistant mistakes, which keeps the sale and the customer."
  },
