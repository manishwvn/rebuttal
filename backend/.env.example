# Copy to .env and fill in. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id PayPal assigns when you register https://<app>/api/webhooks/paypal (events CUSTOMER.DISPUTE.*).
# Deliveries are verified against it; unset, a real sandbox refuses webhooks.
# PAYPAL_WEBHOOK_ID=
# 1 = mock sandbox (default). Set to 0 to use the real PayPal sandbox with the keys above.
REBUTTAL_MOCK=1

# Which model decides: the first provider with a key wins (Anthropic, then Groq, then NVIDIA); none = rules baseline.
# REBUTTAL_REASONER=rules never calls a model, whatever keys are set.
REBUTTAL_REASONER=auto
ANTHROPIC_API_KEY=
REBUTTAL_MODEL=claude-sonnet-5-5
# Groq free tier for qwen/qwen3.8-27b: 30 rpm, 1K/day, 8K tokens/min, 200K tokens/day, 1,000 output tokens/min.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# NVIDIA's OpenAI-compatible endpoint.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3

# Where paused proposals are checkpointed. Unset: in memory in mock mode, checkpoints.sqlite against the real sandbox.
# A file path or sqlite:///file.db for local use, or a postgresql:// URL.
# REBUTTAL_CHECKPOINT_URL=checkpoints.sqlite
# DATABASE_URL: the online Postgres (we use free Supabase). Paused proposals AND the audit log go there; unset means
# SQLite. Needs `uv sync --extra postgres`. Use the Supabase *session pooler* string (port 5432, user postgres.<ref>):
# a long-running server needs session mode; transaction mode (6543) breaks prepared statements and advisory locks.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# SUPABASE_ACCESS_TOKEN=   # only for the Supabase MCP / management API, never read by the app

# REBUTTAL_PROVIDER pins the model provider: groq | nvidia | anthropic (default: first provider with a key).
# REBUTTAL_PROVIDER=
# Where the local JSON-lines audit log goes (the audit log is also in Postgres when DATABASE_URL is set).
# REBUTTAL_AUDIT_PATH=audit.jsonl

# Optional Langfuse tracing (LANGFUSE_HOST also works in place of LANGFUSE_BASE_URL). Off when the keys are unset.
# REBUTTAL_TRACING=0 forces it off. Traces contain buyer details: sandbox and test data only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The API refuses to start against the real sandbox or a shared database without a token (the approve endpoint is the
# human in the approval gate). Any long random string; REBUTTAL_ALLOW_OPEN_API=1 skips the check for local development.
# REBUTTAL_API_TOKEN=

# Browser origins allowed to call the API, comma separated (no wildcard). The Vite dev server is
# http://localhost:5173; the Playwright run uses http://localhost:4173. Unset = no CORS headers.
# REBUTTAL_CORS_ORIGINS=http://localhost:5173

# Sandbox only: a second business account acting as the BUYER, used to create test disputes through the API
# (personal sandbox accounts cannot own a REST app). Scripts only; never set on Render.
# PAYPAL_BUYER_CLIENT_ID=
# PAYPAL_BUYER_CLIENT_SECRET=

# Local development only: lets the API start without REBUTTAL_API_TOKEN against the real sandbox or a database.
# REBUTTAL_ALLOW_OPEN_API=1

# Demo mode: sessions a single client (IP) may create or reset per minute (default 10). Raise it only for tests
# where many runs share one address (the Playwright suite does); leave it unset in production.
# REBUTTAL_DEMO_CLIENT_LIMIT=10
