# Copy to .env and fill in. Never commit .env.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 1 = mock sandbox (default). Set to 0 to use the real PayPal sandbox with the keys above.
REBUTTAL_MOCK=1
# Optional: switches the reasoner from the offline rules baseline to Claude.
ANTHROPIC_API_KEY=
REBUTTAL_MODEL=claude-sonnet-5-5
# Optional: NVIDIA-hosted reasoner (used when ANTHROPIC_API_KEY is empty). REBUTTAL_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_API_KEY=
# Optional: Groq (used after Anthropic, before NVIDIA). Free tier: 30 rpm, 8K tokens/min, 200K tokens/day.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
